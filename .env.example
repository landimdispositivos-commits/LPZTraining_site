# Copie este arquivo para .env e ajuste os valores.
# NUNCA faça commit do .env real — ele já está no .gitignore.

# --- Banco de dados ---
# Valor para rodar `npm run dev` no host, com `docker compose up db mailpit`.
# Se rodar o app via `docker compose up` (serviço `app`), o compose já
# sobrescreve isso automaticamente para apontar para o serviço `db`.
DATABASE_URL=postgres://lpz:lpz_dev_local@localhost:5432/lpz_training

# --- Modo de teste ---
# Obrigatório =true em desenvolvimento local. Faz o checkout usar o
# FakePaymentProvider em vez de chamar o Mercado Pago de verdade.
# NUNCA definir como false sem o adapter real do gateway implementado.
TEST_MODE=true

# --- Mercado Pago (preencher quando o adapter real for implementado) ---
# Use SEMPRE credenciais de sandbox em desenvolvimento.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# --- URL pública do site (usada em redirects do checkout e e-mails) ---
APP_URL=http://localhost:3000

# --- E-mail transacional (Mailpit em dev, captura tudo localmente) ---
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=contato@lpztraining.com.br

# --- Login (Better Auth) ---
# Segredo que assina cookies e tokens. Gere um por ambiente com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# --- Upload de fotos (LocalDiskStorage) ---
UPLOADS_DIR=./uploads
